{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized temple committee administrators with management rights",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "tech_lead"],
          "description": "Administrative authority level"
        },
        "displayName": {
          "type": "string",
          "description": "Full name of committee admin"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of admin record creation"
        }
      },
      "required": ["email", "role"]
    },
    "PandalConfig": {
      "title": "PandalConfig",
      "description": "Global pandal theme, description, and UPI configuration",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the puja committee"
        },
        "subName": {
          "type": "string",
          "description": "Secondary title"
        },
        "tagline": {
          "type": "string",
          "description": "Devotional tagline"
        },
        "location": {
          "type": "string",
          "description": "Pandal location"
        },
        "currentTheme": {
          "type": "string",
          "description": "Current puja year theme"
        },
        "upiId": {
          "type": "string",
          "description": "UPI ID for donations"
        },
        "payeeName": {
          "type": "string",
          "description": "UPI payee name"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["name", "upiId"]
    },
    "LiveUpdate": {
      "title": "LiveUpdate",
      "description": "Realtime announcements and crowd status updates",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Title of the update"
        },
        "message": {
          "type": "string",
          "description": "Details of the update"
        },
        "type": {
          "type": "string",
          "enum": ["live", "crowd", "aarti", "bhog"],
          "description": "Category of notice"
        },
        "isLive": {
          "type": "boolean",
          "description": "Whether notice is actively broadcasted"
        },
        "time": {
          "type": "string",
          "description": "Display time"
        }
      },
      "required": ["title", "message", "type", "isLive"]
    },
    "GalleryImage": {
      "title": "GalleryImage",
      "description": "High definition images of deity and pandal",
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "description": "Cloudinary CDN or asset image URL"
        },
        "title": {
          "type": "string",
          "description": "Title of photo"
        },
        "category": {
          "type": "string",
          "description": "Category"
        },
        "caption": {
          "type": "string",
          "description": "Devotional description"
        }
      },
      "required": ["image", "title", "category"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Devotee inquiries sent to samiti members",
      "type": "object",
      "properties": {
        "memberName": {
          "type": "string",
          "description": "Recipient committee member name"
        },
        "memberRole": {
          "type": "string",
          "description": "Recipient member role"
        },
        "senderName": {
          "type": "string",
          "description": "Devotee full name"
        },
        "senderPhone": {
          "type": "string",
          "description": "Devotee phone or WhatsApp number"
        },
        "purpose": {
          "type": "string",
          "description": "Inquiry category"
        },
        "message": {
          "type": "string",
          "description": "Devotee message details"
        },
        "status": {
          "type": "string",
          "enum": ["new", "contacted", "resolved"],
          "description": "Inquiry resolution status"
        },
        "createdAt": {
          "type": "string",
          "description": "Submission timestamp"
        }
      },
      "required": ["senderName", "senderPhone"]
    },
    "VisitorStats": {
      "title": "VisitorStats",
      "description": "Permanent cumulative visitor counter analytics across all devices and browsers",
      "type": "object",
      "properties": {
        "total": {
          "type": "number",
          "description": "Cumulative total of unique visitors"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["total"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Authenticated temple administrators"
    },
    "/pandal_config/{configId}": {
      "schema": {
        "$ref": "#/entities/PandalConfig"
      },
      "description": "Pandal configuration and UPI payment settings"
    },
    "/live_updates/{updateId}": {
      "schema": {
        "$ref": "#/entities/LiveUpdate"
      },
      "description": "Realtime broadcasts and live announcements"
    },
    "/gallery/{imageId}": {
      "schema": {
        "$ref": "#/entities/GalleryImage"
      },
      "description": "Pandal photo gallery collection"
    },
    "/inquiries/{inquiryId}": {
      "schema": {
        "$ref": "#/entities/Inquiry"
      },
      "description": "Devotee inquiries submitted to the committee"
    }
  }
}
