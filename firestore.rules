rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdminEmail() {
      return isSignedIn() && request.auth.token.email == 'kushwahaarjun9970@gmail.com';
    }

    // 1. Multi-Tenant Websites & Pandals Directory
    // Public get & list allow visitors to browse all pandals or load specific siteId
    // Writes strictly restricted to verified Super Admin
    match /sites/{siteId} {
      allow get, list: if true;
      allow write: if isSuperAdminEmail();
    }

    // 2. Admin credentials stored with secure cryptographic hash values
    // Allows password hash matching from Firebase; write and delete controlled
    match /admins/{adminId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isSuperAdminEmail();
    }

    // 3. System Metadata & Registry
    // Public visitor count analytics: allow read and increment update
    match /system_metadata/visitor_stats {
      allow get, list: if true;
      allow create, update: if request.resource.data.total is number;
    }

    // Public read for system configuration, writes restricted to Super Admin
    match /system_metadata/{docId} {
      allow get, list: if true;
      allow write: if isSuperAdminEmail();
    }

    // 4. Devotee Inquiries & Messages per pandal/website
    // Devotees can submit inquiries (create only) with strict validation.
    // Reading, modifying or deleting inquiries is strictly restricted to Super Admin to protect devotee privacy.
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.senderName is string
                    && request.resource.data.senderName.size() > 0
                    && request.resource.data.senderName.size() <= 100
                    && request.resource.data.senderPhone is string
                    && request.resource.data.senderPhone.size() > 0
                    && request.resource.data.senderPhone.size() <= 30;
      allow read, update, delete: if isSuperAdminEmail();
    }

    // 5. Pandal Configuration per Site (Public get & list, real-time live sync for pandal updates)
    match /pandal_config/{configId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isSuperAdminEmail();
    }

    // 6. Live Temple Notices & Crowd Updates (Public get & list, Super Admin write)
    match /live_updates/{updateId} {
      allow get, list: if true;
      allow write: if isSuperAdminEmail();
    }

    // 7. Gallery Images per Pandal (Public get & list, Super Admin write)
    match /gallery/{imageId} {
      allow get, list: if true;
      allow write: if isSuperAdminEmail();
    }

    // Default deny for all other unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
